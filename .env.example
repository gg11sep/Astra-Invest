# =============================================================================
# Astra-Invest Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# Application
APP_NAME=Astra-Invest
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_dev_password
POSTGRES_DB=astra_invest
DATABASE_URL=postgresql+asyncpg://astra:astra_dev_password@postgres:5432/astra_invest

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers (optional for Batch 1)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
